# cp .env.example .env, пароль взять из корневого .env (POSTGRES_PASSWORD)

DATABASE_URL="postgresql://reshis_avia:reshis_avia_dev_password@localhost:5437/reshis_avia?schema=public"
REDIS_URL="redis://localhost:6382"

HOST=127.0.0.1
PORT=3501
NODE_ENV=development
LOG_LEVEL=debug

# Именно localhost. С 127.0.0.1 браузер считает API другим сайтом и не шлёт куку.
CORS_ORIGIN="http://localhost:3500"

# 0 без прокси, 1 за Caddy.
TRUST_PROXY_HOPS=0

# Данные прогноза, пути от корня репозитория. Без значения берутся эти.
# FORECAST_CSV=data/my_forecast.csv
# ROUTES_CSV=data/routes.csv
